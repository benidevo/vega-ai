{
  "name": "vega-ai-frontend",
  "version": "1.0.0",
  "description": "Frontend build pipeline for Vega AI",
  "scripts": {
    "dev": "npm run build:css -- --watch",
    "build": "npm run build:css -- --minify",
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.9",
    "puppeteer-core": "^24.40.0",
    "tailwindcss": "^3.4.17"
  }
}
